{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Finance report catalog",
  "type": "object",
  "required": [
    "title",
    "intro",
    "reports"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "intro": {
      "type": "string",
      "minLength": 1
    },
    "filters": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "notes": {
      "type": "string"
    },
    "reports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "summary",
          "category",
          "topics",
          "keyTabs",
          "url"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "keyTabs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "url": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              }
            ]
          },
          "descriptionStatus": {
            "enum": [
              "draft",
              "reviewed"
            ]
          }
        }
      }
    }
  },
  "$comment": "Build validator also enforces unique IDs and rejects embedded URL credentials. Topics may span categories; do not infer report authorization from them."
}
